{
  "name": "wonderland-witch",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run build && vite --host",
    "build": "npm run lint && tsc -b && vite build",
    "lint": "oxlint",
    "preview": "npm run build && vite preview",
    "deploy": "npm run build && npm run just-deploy",
    "just-deploy": "wrangler deploy",
    "cf-typegen": "wrangler types",
    "just-test": "c8 node -r source-map-support/register outputs/tests/tests.js",
    "test": "npm run build && npm run just-test"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "@everyonesoftware/common": "^42.0.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "wrangler": "^4.126.0"
  }
}